Ingress = (([]i:{0..NumClients-1} @ ch_in[i]?m1.SIP.SP.DIP.DP.SEQ->sm_in!i.m1.SIP.SP.DIP.DP.SEQ->Skip)
          []([]h:{0..NumPorts-1} @ srv_out_in[h]?m1.SIP.SP.DIP.DP.SEQ.m2.SIP1.SP1.DIP1.DP1.SEQ1->sm_in!h.m1.SIP.SP.DIP.DP.SEQ.m2.SIP1.SP1.DIP1.DP1.SEQ1->Skip)
          [](cmd_in?m2.i.m1.SIP.SP.DIP.DP.SEQ.e->sm_in!C.m2.i.m1.SIP.SP.DIP.DP.SEQ.e->Skip)
          [](cmd_in?m2.i.m1.SIP.SP.DIP.DP.SEQ->sm_in!C.m2.i.m1.SIP.SP.DIP.DP.SEQ->Skip));Ingress;

