EndDataSender(x) = ESend[x]?m.SIP.SP.DIP.DP.SEQ->ch_in[x]!m.SIP.SP.DIP.DP.SEQ->EndDataSender(x);

//=============================================================
// Server 
//=============================================================
Server = (SrvSender|||SrvRecv)||SrvLogic;

SrvRecv = ([]i:{0..NumPorts-1} @ srv_out[i]?m1.SIP.SP.DIP.DP.SEQ->SHan_srv!i.m1.SIP.SP.DIP.DP.SEQ->Skip);SrvRecv;

SrvLogic = SHan_srv?i.m1.SIP.SP.DIP.DP.SEQ->SrvLogic1(i,m1,SIP,SP,DIP,DP,SEQ);SrvLogic;

SrvLogic1(i,m1,SIP,SP,DIP,DP,SEQ) =
if(m1==SYN){
    SrvXmit!i.ACK.DIP.DP.SIP.SP.SEQ+1.SYN.DIP.DP.SIP.SP.N->Skip};

SrvSender = SrvXmit?i.m1.SIP.SP.DIP.DP.SEQ.m2.SIP1.SP1.DIP1.DP1.SEQ1->srv_out_in[i]!m1.SIP.SP.DIP.DP.SEQ.m2.SIP1.SP1.DIP1.DP1.SEQ1->Skip;SrvSender;

