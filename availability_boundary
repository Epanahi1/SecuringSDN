EndLogic(x) = EHan[x]?m1.SIP.SP.DIP.DP.SEQ.m2.SIP1.SP1.DIP1.DP1.SEQ1->EndLogic1(x,m1,SIP,SP,DIP,DP,SEQ,m2,SIP1,SP1,DIP1,DP1,SEQ1);EndLogic(x);

EndLogic1(x,m1,SIP,SP,DIP,DP,SEQ,m2,SIP1,SP1,DIP1,DP1,SEQ1) =
if(m1==ACK && m2==SYN){
    ESend[x]!ACK.DIP1.DP1.SIP1.SP1.SEQ1+1->Skip;
    ESend[x]!DATA.DIP1.DP1.SIP1.SP1.SEQ1+1->Skip};

